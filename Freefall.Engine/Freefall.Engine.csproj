<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Freefall</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NoWarn>$(NoWarn);NU1015;NU1602</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assimp.Net ships .props/.targets that dynamically add/remove PackageReference
         items per runtime, causing VS NuGet restore loops. Exclude its build assets
         and pin the native package explicitly. -->
    <PackageReference Include="DotRecast.Detour" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Detour.Crowd" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Recast" Version="2026.1.3" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
    <PackageReference Include="StirlingLabs.assimp.native.win-x64" Version="5.2.5.4" />
    <PackageReference Include="StirlingLabs.Assimp.Net" Version="23.4.1" ExcludeAssets="buildTransitive;build" />
    <PackageReference Include="RawInput.Sharp" Version="0.1.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.2" />
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.2" />
    <PackageReference Include="Vortice.Dxc" Version="3.8.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.2" />
    <PackageReference Include="Vortice.Mathematics" Version="2.1.0" />
    <PackageReference Include="Vortice.Pix.Native" Version="1.0.1" />
    <PackageReference Include="Vortice.Win32" Version="2.3.0" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.2" />
    <PackageReference Include="Vortice.XAudio2" Version="3.8.2" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="LiteYaml" Version="0.1.1" />
    <!-- Built here in Release (ThirdParty/nuget, nuget.config): nuget.org's 5.0.1-alpha1 is a debug build -->
    <PackageReference Include="PhysX.Net" Version="5.0.1-release1" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- The game's UI is a Squid desktop (Freefall.UI.GameUI), built by project scripts -->
    <ProjectReference Include="..\..\..\Squid\Squid.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GDI+ (System.Drawing) for UI.RuntimeFont, which rasterizes TTFs (a UI skin's Typeface) into font atlases at
         run time, in the editor and in a published game. A framework reference, not UseWindowsForms: that would add a
         global using of System.Windows.Forms, whose Keys, Message and Cursor clash with the engine's. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Not in a published game's folder (the player's dotnet publish): Publish packs them into Data/engine.ffpack
         (Assets.EngineFiles), and Resources/Terrain (old splat maps) is read by nothing -->
    <None Update="Resources\**">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <!-- meshoptimizer (LOD generation at import), built from ThirdParty/meshoptimizer with build.cmd; import only, so not published -->
    <None Include="..\ThirdParty\meshoptimizer\win-x64\meshoptimizer.dll">
      <Link>meshoptimizer.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
